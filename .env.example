# Keycloak (in-app auth — backend talks to Keycloak)
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=jobtracker
KEYCLOAK_CLIENT_ID=jobtracker-api
KEYCLOAK_CLIENT_SECRET=change-me

# PostgreSQL — use a dedicated database name (not the default "postgres")
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jobtracker

# Backend
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# Optional: shared cookie domain (e.g. .example.com) and force Secure cookies
# COOKIE_DOMAIN=.example.com
# COOKIE_SECURE=true

# SMTP for in-app password reset emails (Hetzner managed mail)
# Coolify / cloud: prefer 587 + STARTTLS (SMTP_SECURE=false). Local: 465 often works.
# SMTP_HOST=mail.your-server.de
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=system@example.com
# SMTP_PASS=change-me
# SMTP_FROM=system@example.com
# SMTP_FROM_NAME=Job Tracker

# Cloudflare Turnstile (optional; enables widget on login/register/forgot-password)
# Accepts TURNSTILE_SITEKEY / TURNSTILE_SECRETKEY aliases too.
# TURNSTILE_SITE_KEY=your-site-key
# TURNSTILE_SECRET_KEY=your-secret-key

# Optional Redis for durable rate limits + login/forgot lockouts
# REDIS_URL=redis://:PASSWORD@HOST:6379/0

# Frontend (Next.js — public vars only; baked into the image at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Coolify Compose Domains:
#   frontend → internal port 3000
#   backend  → internal port 4000
# Set CORS_ORIGIN / NEXT_PUBLIC_API_URL / COOKIE_DOMAIN to your public URLs.
