# Keycloak (in-app auth — backend talks to Keycloak)
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=jobtracker
KEYCLOAK_CLIENT_ID=jobtracker-api
KEYCLOAK_CLIENT_SECRET=change-me

# PostgreSQL — use a dedicated database name (not the default "postgres")
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jobtracker

# Backend
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Frontend (Next.js — public vars only)
NEXT_PUBLIC_API_URL=http://localhost:4000
